{
  "manifest_version": 3,
  "name": "오늘 할 일 작성기",
  "description": "오늘의 할 일을 추가하고, 완료하고, 가볍게 정리하세요.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "action": {
    "default_title": "오늘 할 일 작성기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
