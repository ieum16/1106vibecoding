{
  "manifest_version": 3,
  "name": "메일 정리함 · Outlook 업무 도우미",
  "version": "1.0.0",
  "description": "키워드로 Outlook 받은편지함을 미리 보고 분류합니다. 중단, 이어하기, 되돌리기와 주기 실행을 지원합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": ["https://graph.microsoft.com/*", "https://login.microsoftonline.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "메일 정리함 열기"},
  "options_page": "dashboard.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
