{
  "manifest_version": 3,
  "name": "교육 시간표",
  "version": "1.3.0",
  "description": "교육 시간표와 할 일을 한곳에서 관리하는 나만의 새 탭.",
  "permissions": [
    "storage",
    "identity",
    "identity.email"
  ],
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "action": {
    "default_title": "교육 시간표 열기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
