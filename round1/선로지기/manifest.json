{
  "manifest_version": 3,
  "name": "오늘 할 일 작성기",
  "version": "1.1.0",
  "description": "오늘 할 일을 추가하고 완료 여부를 관리합니다. 서울의 오늘 날씨도 함께 보여 줍니다.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.open-meteo.com/*"],
  "action": {
    "default_title": "오늘 할 일 작성기",
    "default_popup": "popup.html"
  }
}
